# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional model overrides (defaults shown)
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image-preview,gemini-3-pro-image-preview
GEMINI_OMNI_MODEL=gemini-omni-1.1-flash-preview

# Optional: YouTube Data API v3 key for "most popular" trend signals in the planner.
# Enable "YouTube Data API v3" in Google Cloud Console, then paste the key here.
# YOUTUBE_API_KEY=your-youtube-api-key-here

# Optional: Reddit script-app credentials for "hot posts" trend signals from any IP.
# Create a "script" app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your-reddit-client-id
# REDDIT_CLIENT_SECRET=your-reddit-client-secret

# Optional: email delivery for Trend Watch digests (any SMTP provider).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<app password from myaccount.google.com/apppasswords>
# Without these, Trend Watch still runs and uses macOS desktop notifications.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# DIGEST_EMAIL_TO=you@gmail.com

# Optional: run the Trend Watch agent in the cloud instead of locally.
# Deploy trend-watch-service/ to Cloud Run (see its README), then point the app at it.
# The local scheduler turns off; the planner pushes channels & syncs ideas automatically.
# TREND_WATCH_REMOTE_URL=https://trend-watch-xxxxx-uc.a.run.app
# TREND_WATCH_REMOTE_SECRET=same-secret-as-the-service

# Optional: sync data across machines via YOUR Google Cloud project.
#   - Output media (videos/audio/thumbnails/renders) → Cloud Storage bucket
#   - Projects + planner metadata → Firestore
# Both Macs use the same values below and share identical data. Leave unset to run
# fully local (files in public/outputs + browser localStorage), exactly as before.
#
# Setup once:
#   gcloud config set project your-project-id
#   gcloud services enable storage.googleapis.com firestore.googleapis.com
#   gcloud storage buckets create gs://your-unique-bucket-name --location=us-central1
#   gcloud firestore databases create --location=us-central1   # if you have none yet
#   Auth: run `gcloud auth application-default login` on each Mac (uses your login),
#   OR create a service-account key and set GOOGLE_APPLICATION_CREDENTIALS to its path.
#   Then: npm install   (pulls the optional @google-cloud packages)
#
# GCP_PROJECT_ID=your-project-id
# GCS_BUCKET=your-unique-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIRESTORE_DATABASE=(default)

# Optional: direct upload to YouTube from the Publish step (OAuth 2.0).
# 1) Enable "YouTube Data API v3" in your project.
# 2) Create an OAuth Client ID (type: Web application).
# 3) Add authorized redirect URIs:
#      http://localhost:3000/api/youtube/callback          (local Mac)
#      https://YOUR-CLOUD-RUN-URL/api/youtube/callback      (deployed)
# 4) Paste the client id/secret here. Uploads default to PRIVATE.
# YT_CLIENT_ID=xxxx.apps.googleusercontent.com
# YT_CLIENT_SECRET=your-oauth-client-secret

# Optional: free stock video (b-roll) to back a narrative instead of AI-generating
# every scene. Get a free key at pexels.com/api (best) or pixabay.com/api/docs.
# PEXELS_API_KEY=your-pexels-key
# PIXABAY_API_KEY=your-pixabay-key

# Optional: server port (defaults to 3000; Cloud Run injects 8080)
# PORT=3000
