# Required: Gemini API key for the ideas agent
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3.6-flash

# Required in production: shared secret. The local app and Cloud Scheduler must
# send it as the "x-agent-secret" header.
AGENT_SECRET=change-me-to-a-long-random-string

# Recommended: YouTube Data API v3 key for the "most popular" trend signal
# YOUTUBE_API_KEY=your-youtube-api-key

# Optional: Reddit script-app credentials (hot-posts trend signal from any IP)
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...

# Email digests (any SMTP provider; Gmail app-password works)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# DIGEST_EMAIL_TO=you@gmail.com

# State storage:
# On Cloud Run set GCS_BUCKET (service account needs Storage Object Admin on it).
# Without it, state lives in ./state.json (fine for a VM or local dev).
# GCS_BUCKET=your-trend-watch-bucket
# GCS_STATE_OBJECT=trend-watch-state.json

# Self-scheduling for VM/local usage (hours). Leave unset on Cloud Run and use
# Cloud Scheduler instead — Cloud Run scales to zero between runs.
# RUN_INTERVAL_HOURS=5

# PORT=8787
